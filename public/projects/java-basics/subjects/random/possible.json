{
  "$schema": "../../../../../schemas/game.schema.json",
  "type": "multi",
  "title": "אילו ערכים אפשריים?",
  "settings": {
    "lives": 3
  },
  "questions": [
    {
      "id": "nextint-5-3",
      "question": "אילו מהערכים יכולים לצאת?",
      "code": "rnd.nextInt(5) + 3",
      "options": [
        "2",
        "3",
        "5",
        "7",
        "8"
      ],
      "answers": [
        1,
        2,
        3
      ],
      "explanation": "nextInt(5) נותן 0 עד 4, ועוד 3: 3 עד 7."
    },
    {
      "id": "math-4",
      "question": "אילו מהערכים יכולים לצאת?",
      "code": "(int) (Math.random() * 4)",
      "options": [
        "0",
        "1",
        "3",
        "4",
        "-1"
      ],
      "answers": [
        0,
        1,
        2
      ]
    },
    {
      "id": "dice-sum",
      "question": "זורקים שתי קוביות. אילו סכומים אפשריים?",
      "code": "int sum = (rnd.nextInt(6) + 1) + (rnd.nextInt(6) + 1);",
      "options": [
        "1",
        "2",
        "7",
        "12",
        "13"
      ],
      "answers": [
        1,
        2,
        3
      ],
      "explanation": "כל קוביה 1 עד 6, אז הסכום 2 עד 12."
    },
    {
      "id": "minus",
      "question": "אילו מהערכים יכולים לצאת?",
      "code": "rnd.nextInt(21) - 10",
      "options": [
        "-10",
        "0",
        "10",
        "11",
        "-11"
      ],
      "answers": [
        0,
        1,
        2
      ],
      "explanation": "0 עד 20, פחות 10: מ-10- עד 10."
    }
  ]
}
